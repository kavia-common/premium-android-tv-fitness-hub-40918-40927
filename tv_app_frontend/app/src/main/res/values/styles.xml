<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ocean Professional Theme on top of Leanback -->
    <style name="AppTheme" parent="Theme.Leanback">
        <item name="android:windowBackground">@drawable/ocean_bg_gradient</item>
        <item name="android:colorPrimary">@color/ocean_primary</item>
        <item name="android:colorAccent">@color/ocean_secondary</item>
        <item name="android:textColorPrimary">@color/ocean_text_dark</item>
        <!-- Disable ripple for TV remote -->
        <item name="android:colorControlHighlight">@android:color/transparent</item>
    </style>

    <!-- Card styles (not directly referenced by Leanback ImageCardView but here for consistency) -->
    <style name="CardStyle">
        <item name="android:background">@color/card_surface</item>
        <item name="android:foreground">@color/ocean_secondary</item>
    </style>
</resources>
